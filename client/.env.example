# LocalDrop Client Environment Variables
# Optional: Set this only if using a standalone external signaling server in production.
# In development, the Vite proxy automatically forwards /ws to ws://localhost:8080.
# VITE_WS_URL=wss://signaling.yourdomain.com

# Optional canonical production app URL for QR code and pairing link generation.
# Defaults to window.location if not specified.
# VITE_PUBLIC_APP_URL=https://client-taupe-one-79.vercel.app

# Optional TURN credentials fetch. STUN-only is the default.
# VITE_ENABLE_TURN=true
