{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "localdrop-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALING_HUB",
        "class_name": "SignalingHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalingHub"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": ""
  },
  "observability": {
    "enabled": true
  }
}
