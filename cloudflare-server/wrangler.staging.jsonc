{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "localdrop-network-v2-rc",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../client/dist",
    "run_worker_first": ["/ws", "/health", "/stats", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SIGNALING_HUB", "class_name": "SignalingHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalingHub"] }],
  "vars": {
    "STRICT_BROWSER_ORIGINS": "1",
    "ALLOWED_ORIGINS": "https://localdrop-network-v2-rc.jagansakthi979.workers.dev",
    "TURN_ALLOWED_ORIGINS": "https://localdrop-network-v2-rc.jagansakthi979.workers.dev"
  },
  "observability": { "enabled": true }
}
