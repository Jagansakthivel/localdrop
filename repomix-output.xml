.ldx-footer-links a {
  display: inline-flex;
  gap: 8px;
  align-items: center;
  min-height: 44px;
  padding: 8px 12px;
  border-radius: 10px;
  text-decoration: none;
  color: var(--ldx-secondary);
  font-size: 12px;
  font-weight: 600;
  transition: background 0.17s, color 0.17s;
  white-space: nowrap;
}

.ldx-footer-links a:hover {
  background: var(--ldx-soft);
  color: var(--ldx-ink);
}

.ldx-footer .ldx-signature {
  position: relative;
  display: inline-block;
  color: var(--ldx-accent);
  font-weight: 750;
  animation: ldx-signature-light 1.5s ease-out both;
}

.ldx-signature svg {
  position: absolute;
  left: -2%;
  width: 104%;
  height: 7px;
  bottom: -3px;
  overflow: visible;
  pointer-events: none;
}

.ldx-signature path {
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-dasharray: 65;
  stroke-dashoffset: 0;
  animation: ldx-signature-draw 0.85s 0.25s ease-out backwards;
}

@keyframes ldx-signature-draw {
  from {
    stroke-dashoffset: 65;
  }
  to {
    stroke-dashoffset: 0;
  }
}

@keyframes ldx-signature-light {
  0%,
  100% {
    text-shadow: none;
  }
  45% {
    text-shadow: 0 0 12px color-mix(in oklab, var(--ldx-accent) 45%, transparent);
  }
}

@media (max-width: 760px) {
  .ldx-header {
    padding: 12px 14px;
    gap: 6px;
  }
  .ldx-header-right {
    gap: 2px;
  }
  .ldx-device-wrap {
    padding-inline-start: 4px;
  }
  .ldx-device-button {
    width: 44px;
    padding: 0;
    gap: 2px;
    justify-content: center;
  }
  .ldx-device-content {
    display: none;
  }
  .ldx-device-chevron svg {
    width: 12px;
  }
  .ldx-status {
    padding: 6px;
  }
  .ldx-icon-button {
    width: 44px;
    height: 44px;
  }
  .ldx-device-popover {
    position: fixed;
    top: 72px;
    right: 12px;
    width: min(320px, calc(100vw - 24px));
  }
}

@media (max-width: 360px) {
  .ldx-header {
    flex-wrap: wrap;
  }
  .ldx-header-right {
    margin-inline-start: auto;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ldx-status-dot--connecting {
    animation: none;
  }
  .ldx-footer-links a {
    transition: none;
  }
  .ldx-footer .ldx-signature,
  .ldx-signature path {
    animation: none;
  }
}
