<file path="client/src/components/ActivityRow.tsx">
import type { ReactNode } from 'react';
import { Check, ArrowUpRight, ArrowDownLeft, AlertCircle, X } from 'lucide-react';

export type ActivityState = 'active' | 'complete' | 'failed' | 'cancelled';

export interface ActivityRowProps {
  name: string;
  size: string;
  direction: 'send' | 'receive';
  state: ActivityState;
  progress: number;
  detail?: string;
  saveControl?: ReactNode;
  onCancel?: () => void;
}

export function ActivityRow({
  name,
  size,
  direction,
  state,
  progress,
  detail,
  saveControl,
  onCancel,
}: ActivityRowProps) {
  const active = state === 'active';
  const received = direction === 'receive';
  const Icon =
    state === 'failed'
      ? AlertCircle
      : state === 'cancelled'
        ? X
        : received
          ? ArrowDownLeft
          : ArrowUpRight;
  const label =
    state === 'complete'
      ? received
        ? 'Received'
        : 'Sent'
      : state === 'failed'
        ? 'Failed'
        : state === 'cancelled'
          ? 'Cancelled'
          : received
            ? 'Receiving'
            : 'Sending';
  const pct = Number.isFinite(progress) ? Math.min(99, Math.max(0, progress)) : 0;
  const dot = name.lastIndexOf('.');
  const split = dot > 0 && name.length - dot <= 12;

  return (
    <article className="ldv-activity-row" data-direction={direction} data-state={state}>
      <span className="ldv-file-mark" aria-hidden="true">
        <Icon size={20} />
      </span>
      <div className="ldv-file-body">
        <div className="ldv-filename" title={name} aria-label={name}>
          <span>{split ? name.slice(0, dot) : name}</span>
          {split && <span>{name.slice(dot)}</span>}
        </div>
        <div className="ldv-meta">
          <span className="ldt-size">{size}</span> · {label}
          {detail && ` · ${detail}`}
        </div>
        {active && <progress max={100} value={pct} aria-label={`Transfer progress: ${name}`} />}
        {received && state === 'complete' && saveControl && (
          <div className="ldv-save">{saveControl}</div>
        )}
      </div>
      {state === 'complete' && <Check className="ldv-success" size={18} aria-label="Transfer complete" />}
      {active && onCancel && (
        <button
          type="button"
          className="ldv-cancel"
          onClick={onCancel}
          aria-label={`Cancel ${name}`}
        >
          <X size={18} />
        </button>
      )}
    </article>
  );
}
</file>

<file path="client/src/components/IncomingTransferPopup.tsx">
import { useEffect, useRef, useState } from 'react';
import { AnimatePresence, motion, useReducedMotion } from 'motion/react';
import {
  Laptop,
  Smartphone,
  ArrowDownToLine,
  FileText,
  FileImage,
  FileVideo,
  FileAudio,
  FileArchive,
  File,
  Check,
  X,
} from 'lucide-react';
import { formatFilename } from '../utils/formatFilename';

export interface IncomingTransferOffer {
  id: string;
  senderName: string;
  filename: string;
  size: number;
  mime?: string;
  senderDeviceType?: 'mobile' | 'desktop';
  receiverDeviceType?: 'mobile' | 'desktop';
}

export interface IncomingTransferPopupProps {
  offer: IncomingTransferOffer | null;
  onAccept: (id: string) => void | Promise<void>;
  onDecline: (id: string) => void | Promise<void>;
  receiverDeviceType?: 'mobile' | 'desktop';
}

function formatSize(bytes: number): string {
  if (!Number.isFinite(bytes) || bytes < 0) {
    return 'Unknown size';
  }

  if (bytes === 0) return '0 B';

  const units = ['B', 'KB', 'MB', 'GB', 'TB'];
  const index = Math.min(
    units.length - 1,
    Math.max(0, Math.floor(Math.log(bytes) / Math.log(1024)))
  );

  return `${Number((bytes / 1024 ** index).toFixed(1))} ${units[index]}`;
}

function TransferFilePreviewIcon({
  mime = '',
  filename = '',
  size = 24,
}: {
  mime?: string;
  filename?: string;
  size?: number;
}) {
  if (mime.startsWith('image/')) return <FileImage size={size} strokeWidth={1.6} />;
  if (mime.startsWith('video/')) return <FileVideo size={size} strokeWidth={1.6} />;
  if (mime.startsWith('audio/')) return <FileAudio size={size} strokeWidth={1.6} />;

  if (/\.(zip|rar|7z|tar|gz|bz2|xz)$/i.test(filename)) {
    return <FileArchive size={size} strokeWidth={1.6} />;
  }

  if (/\.(pdf|docx?|txt|xlsx?|pptx?|md|json|csv)$/i.test(filename)) {
    return <FileText size={size} strokeWidth={1.6} />;
  }

  return <File size={size} strokeWidth={1.6} />;
}

export function IncomingTransferPopup({
  offer,
  onAccept,
  onDecline,
  receiverDeviceType = 'desktop',
}: IncomingTransferPopupProps) {
  const reducedMotion = useReducedMotion();

  const dialogRef = useRef<HTMLDialogElement>(null);
  const declineRef = useRef<HTMLButtonElement>(null);
  const previousFocusRef = useRef<HTMLElement | null>(null);

  const processingRef = useRef(false);

  const [decision, setDecision] = useState<'idle' | 'accepted' | 'declined'>('idle');
  const [error, setError] = useState('');

  // Store information from previous render to preserve active details during exit animation
  const [prevOffer, setPrevOffer] = useState<IncomingTransferOffer | null>(null);
  const [cachedOffer, setCachedOffer] = useState<IncomingTransferOffer | null>(offer);

  if (offer !== prevOffer) {
    setPrevOffer(offer);
    if (offer) {
      setCachedOffer(offer);
    }
  }

  useEffect(() => {
    const dialog = dialogRef.current;
    if (!dialog) return;

    if (offer) {
      processingRef.current = false;

      if (!dialog.open) {
        previousFocusRef.current = document.activeElement as HTMLElement | null;
        try {
          dialog.showModal();
        } catch {
          // Fallback if showModal throws in test environment
          dialog.setAttribute('open', '');
        }
        // Focus decline button initially as safe default
        requestAnimationFrame(() => {
          declineRef.current?.focus();
        });
      }
    }
  }, [offer]);

  const handleExitComplete = () => {
    const dialog = dialogRef.current;
    if (!offer && dialog && dialog.open) {
      try {
        dialog.close();
      } catch {
        dialog.removeAttribute('open');
      }
      setDecision('idle');
      setError('');
      processingRef.current = false;

      // Restore focus to previously active element
      if (previousFocusRef.current && typeof previousFocusRef.current.focus === 'function') {
        previousFocusRef.current.focus();
      }
    }
  };

  async function respond(action: 'accepted' | 'declined') {
    const targetOffer = offer || cachedOffer;
    if (!targetOffer || processingRef.current) return;

    processingRef.current = true;
    setDecision(action);
    setError('');

    try {
      if (action === 'accepted') {
        await onAccept(targetOffer.id);
      } else {
        await onDecline(targetOffer.id);
      }
    } catch {
      processingRef.current = false;
      setDecision('idle');
      setError('Unable to respond. Please try again.');
    }
  }

  const activeOffer = offer || (decision !== 'idle' ? cachedOffer : null);

  const SenderIcon = activeOffer?.senderDeviceType === 'mobile' ? Smartphone : Laptop;
  const ReceiverIcon =
    (activeOffer?.receiverDeviceType || receiverDeviceType) === 'mobile' ? Smartphone : Laptop;

  return (
    <dialog
      ref={dialogRef}
      className="ld-incoming-dialog"
      aria-labelledby="ld-incoming-title"
      aria-describedby="ld-incoming-description"
      onCancel={(event) => {
        event.preventDefault();
        void respond('declined');
      }}
    >
      <AnimatePresence mode="wait" onExitComplete={handleExitComplete}>
        {activeOffer && (
          <motion.section
            key={activeOffer.id}
            className="ld-incoming-card"
            initial={{
              opacity: 0,
              y: reducedMotion ? 0 : 24,
              scale: reducedMotion ? 1 : 0.96,
            }}
            animate={{
              opacity: 1,
              y: 0,
              scale: 1,
            }}
            exit={{
              opacity: 0,
              y: reducedMotion ? 0 : 12,
              scale: reducedMotion ? 1 : 0.98,
            }}
            transition={
              reducedMotion
                ? { duration: 0 }
                : {
                    type: 'spring',
                    stiffness: 320,
                    damping: 27,
                    mass: 0.8,
                  }
            }
          >
            <div className="ld-incoming-handle" />

            <span className="ld-incoming-kicker">
              <span className="ld-incoming-dot" />
              Transfer request
            </span>

            {/* Device transfer illustration */}
            <div className="ld-incoming-illustration" aria-hidden="true">
              <motion.div
                className="ld-incoming-device"
                initial={{ x: reducedMotion ? 0 : -10 }}
                animate={{ x: 0 }}
                transition={reducedMotion ? { duration: 0 } : { duration: 0.3 }}
              >
                <SenderIcon size={30} strokeWidth={1.5} />
              </motion.div>

              <div className="ld-incoming-route">
                <span />
                {[0, 1, 2].map((index) => (
                  <motion.i
                    key={index}
                    animate={
                      reducedMotion
                        ? { opacity: 0.7 }
                        : {
                            opacity: [0.25, 1, 0.25],
                            scale: [0.8, 1.2, 0.8],
                          }
                    }
                    transition={{
                      duration: 0.65,
                      repeat: reducedMotion ? 0 : 1,
                      delay: index * 0.1,
                    }}
                  />
                ))}
                <span />
              </div>

              <motion.div
                className="ld-incoming-device ld-incoming-receiver"
                initial={{ x: reducedMotion ? 0 : 10 }}
                animate={{ x: 0 }}
                transition={reducedMotion ? { duration: 0 } : { duration: 0.3 }}
              >
                <ReceiverIcon size={30} strokeWidth={1.5} />
              </motion.div>
            </div>

            {/* Request details */}
            <h2 id="ld-incoming-title">Incoming file</h2>

            <p id="ld-incoming-description">
              <strong>{activeOffer.senderName}</strong>
              {' wants to share a file with you.'}
            </p>

            {/* File preview */}
            <div className="ld-incoming-file">
              <div className="ld-incoming-file-icon">
                <TransferFilePreviewIcon
                  mime={activeOffer.mime}
                  filename={activeOffer.filename}
                  size={24}
                />
              </div>

              <div className="ld-incoming-file-details">
                <strong title={activeOffer.filename}>
                  {formatFilename(activeOffer.filename, 38)}
                </strong>
                <span>{formatSize(activeOffer.size)}</span>
              </div>
            </div>

            <p className="ld-incoming-note">Only accept files you trust.</p>

            {/* Decision buttons */}
            <div className="ld-incoming-actions">
              <motion.button
                ref={declineRef}
                type="button"
                className="ld-incoming-decline"
                disabled={decision !== 'idle'}
                whileTap={reducedMotion ? undefined : { scale: 0.96 }}
                onClick={() => void respond('declined')}
              >
                <X size={17} />
                {decision === 'declined' ? 'Declining…' : 'Decline'}
              </motion.button>

              <motion.button
                type="button"
                className="ld-incoming-accept"
                disabled={decision !== 'idle'}
                whileTap={reducedMotion ? undefined : { scale: 0.96 }}
                onClick={() => void respond('accepted')}
              >
                {decision === 'accepted' ? (
                  <Check size={18} />
                ) : (
                  <ArrowDownToLine size={18} />
                )}
                {decision === 'accepted' ? 'Accepting…' : 'Accept'}
              </motion.button>
            </div>

            {error && (
              <p className="ld-incoming-error" role="alert">
                {error}
              </p>
            )}
          </motion.section>
        )}
      </AnimatePresence>
    </dialog>
  );
}
</file>

