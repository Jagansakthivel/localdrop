<file path="client/src/utils/saveReceivedFile.ts">
interface WritableFileStream {
  write(data: Blob): Promise<void>;
  close(): Promise<void>;
  abort(): Promise<void>;
}

export interface SaveFileHandle {
  name: string;
  createWritable(): Promise<WritableFileStream>;
}

interface SavePickerOptions {
  suggestedName?: string;
  startIn?: "downloads" | "documents" | "desktop";
}

type SavePickerWindow = Window & {
  showSaveFilePicker?: (
    options?: SavePickerOptions
  ) => Promise<SaveFileHandle>;
};

export type SaveResult =
  | { status: "saved"; filename: string }
  | { status: "download-started"; filename: string }
  | { status: "cancelled" }
  | { status: "failed"; message: string };

export function supportsNativeSavePicker(): boolean {
  return (
    typeof window !== "undefined" &&
    window.isSecureContext &&
    typeof (window as SavePickerWindow).showSaveFilePicker === "function"
  );
}

export async function chooseSaveLocation(
  filename: string
): Promise<SaveFileHandle | null> {
  const browser = window as SavePickerWindow;

  if (!supportsNativeSavePicker()) {
    return null;
  }

  try {
    return await browser.showSaveFilePicker!({
      suggestedName: filename,
      startIn: "downloads",
    });
  } catch (error) {
    if (
      error instanceof DOMException &&
      error.name === "AbortError"
    ) {
      return null;
    }

    throw error;
  }
}

export async function writeReceivedFile(
  file: File,
  handle: SaveFileHandle
): Promise<SaveResult> {
  let writable: WritableFileStream | null = null;

  try {
    writable = await handle.createWritable();

    await writable.write(file);
    await writable.close();

    return {
      status: "saved",
      filename: handle.name,
    };
  } catch (error) {
    if (writable) {
      await writable.abort().catch(() => {});
    }

    return {
      status: "failed",
      message:
        error instanceof Error
          ? error.message
          : "Unable to save the received file.",
    };
  }
}

export function downloadReceivedFile(
  file: File
): SaveResult {
  const url = URL.createObjectURL(file);

  const link = document.createElement("a");

  link.href = url;
  link.download = file.name;
  link.style.display = "none";

  try {
    document.body.appendChild(link);
    link.click();

    return {
      status: "download-started",
      filename: file.name,
    };
  } catch (error) {
    return {
      status: "failed",
      message:
        error instanceof Error
          ? error.message
          : "Unable to initiate download.",
    };
  } finally {
    link.remove();

    setTimeout(() => {
      URL.revokeObjectURL(url);
    }, 30000);
  }
}

export async function computeFileSha256(file: Blob | File): Promise<string> {
  const buffer = await file.arrayBuffer();
  const hashBuffer = await crypto.subtle.digest("SHA-256", buffer);
  const hashArray = Array.from(new Uint8Array(hashBuffer));
  return hashArray.map((b) => b.toString(16).padStart(2, "0")).join("");
}

export async function saveReceivedFile(
  file: File
): Promise<SaveResult> {
  if (!supportsNativeSavePicker()) {
    return downloadReceivedFile(file);
  }

  try {
    const handle = await chooseSaveLocation(file.name);

    if (!handle) {
      return { status: "cancelled" };
    }

    return await writeReceivedFile(file, handle);
  } catch (error) {
    return {
      status: "failed",
      message:
        error instanceof Error
          ? error.message
          : "Unable to open the file picker.",
    };
  }
}
</file>

<file path="client/src/utils/transportCopy.ts">
import type { ConnectionState, TransportType } from '../types/network';

export interface TransportCopy {
  badgeLabel: string;
  peerLabel: string;
  dropSubtitle: string;
  diagnosticsLabel: string;
  securityLabel: string;
  isDirect: boolean;
  isRelayed: boolean;
}

/**
 * Honest transport status & security copy derived strictly from live channel
 * or confirmed relay readiness.
 */
export function getTransportCopy(
  connectionState?: ConnectionState,
  transport?: TransportType,
  wsConnected?: boolean
): TransportCopy {
  if (connectionState === 'direct' && transport === 'webrtc') {
    return {
      badgeLabel: 'Direct P2P',
      peerLabel: 'Direct peer-to-peer',
      dropSubtitle: 'Send files directly to your connected device over WebRTC.',
      diagnosticsLabel: 'Direct WebRTC DataChannel',
      securityLabel: 'DTLS-SRTP encrypted peer-to-peer',
      isDirect: true,
      isRelayed: false,
    };
  }

  if (connectionState === 'relayed' && wsConnected) {
    return {
      badgeLabel: 'Cloud Relay',
      peerLabel: 'Relayed via server',
      dropSubtitle: 'Send files to your connected device via the WebSocket relay.',
      diagnosticsLabel: 'WebSocket Relay (TLS in transit)',
      securityLabel: 'TLS-encrypted WebSocket relay',
      isDirect: false,
      isRelayed: true,
    };
  }

  return {
    badgeLabel: 'Connecting',
    peerLabel: 'Establishing link…',
    dropSubtitle: 'Preparing connection to your peer.',
    diagnosticsLabel: wsConnected ? 'Signaling ready (negotiating)' : 'Offline / Reconnecting',
    securityLabel: 'DTLS when direct · TLS on signaling',
    isDirect: false,
    isRelayed: false,
  };
}
