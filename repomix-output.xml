      if (ackTimer) clearTimeout(ackTimer);

      isTransferActiveRef.current = false;

      if (!acknowledged) {
        setStatusText(`Transfer failed: no acknowledgement`);
        return false;
      }

      setTotalSessionBytes((b) => b + file.size);
      setSharedItems((prev) => [
        {
          id: transferId || crypto.randomUUID(),
          kind: 'file',
          file,
          direction: 'sent',
          timestamp: Date.now(),
        },
        ...prev,
      ]);

      const totalElapsed = Math.max(0.05, (performance.now() - startTime) / 1000);
      const finalSpeed = Number((file.size / totalElapsed / (1024 * 1024)).toFixed(1));

      setTransferProgress(100);
      setTelemetry({
        transferId,
        direction: 'sending',
        fileName: file.name,
        fileMime: mime,
        totalBytes: file.size,
        transferredBytes: file.size,
        speedMbps: finalSpeed,
        etaSeconds: 0,
        progress: 100,
        awaitingApproval: false,
      });

      setStatusText(`Sent ${file.name}`);
      setTimeout(() => setTelemetry(null), 1200);
      return true;
    },
    [sendJsonPacket, isV2Active, closeRtcResources, updateDiagnostics]
  );

  return {
    wsConnected,
    connectionState,
    transport,
    diagnostics,
    connectedPeer,
    localDeviceName,
    pin,
    autoAccept,
    setAutoAccept,
    totalSessionBytes,
    remoteClipboard,
    localClipboard,
    sharedItems,
    transferProgress,
    telemetry,
    incomingOffer,
    statusText,
    lastError,
    connectWithPin,
    disconnect,
    pushMyClipboard,
    requestRemoteClipboard,
    sendTextOrLink,
    sendFile,
    acceptIncomingFile,
    declineIncomingFile,
    cancelTransfer,
  };
}
