@import '@fontsource-variable/manrope';
@import '@fontsource-variable/geist';

:root {
  --ld-paper: #fffdf8;
  --ld-ink: #252723;
  --ld-accent: #c9472b;
  --ld-sage: #dce5d2;
  --ld-line: #dedbd1;
}

[data-theme='dark'],
.dark,
.ld-dark {
  --ld-paper: #121319;
  --ld-surface: #1b1d26;
  --ld-elevated: #20222d;
  --ld-secondary: #272a35;
  --ld-ink: #f4f1f1;
  --ld-muted: #acaabb;
  --ld-line: #363846;
  --ld-accent: #ff8b76;
  --ld-accent-hover: #ff9e8d;
  --ld-success: #76c7a7;
  --ld-animation: #b7a4f4;
  --ld-sage: #272a35;
}

.ld-dark .ld-handshake-sheet {
  background: var(--ld-elevated);
  border: 1px solid var(--ld-line);
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.45);
}

.ld-dark .ld-device {
  background: var(--ld-secondary);
  color: var(--ld-animation);
  box-shadow: 0 6px 0 color-mix(in oklab, var(--ld-secondary), black 20%);
}

.ld-dark .ld-device.ld-peer {
  background: var(--ld-elevated);
  color: var(--ld-accent);
  box-shadow: 0 6px 0 color-mix(in oklab, var(--ld-elevated), black 20%);
}

.ld-dark .ld-bridge {
  color: var(--ld-animation);
}

.ld-dark .ld-paper {
  background: var(--ld-surface);
  border-color: var(--ld-line);
  box-shadow: 0 5px 12px rgba(0, 0, 0, 0.35);
}

.ld-dark .ld-transfer-art {
  background: var(--ld-surface);
  border-color: var(--ld-line);
}

.ld-dark .ld-in .ld-transfer-art {
  background: var(--ld-surface);
