  }

  if (bytes === 0) return '0 B';

  const units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];

  const index = Math.min(
    Math.max(0, Math.floor(Math.log(bytes) / Math.log(1024))),
    units.length - 1
  );

  const value = bytes / Math.pow(1024, index);

  return `${Number(value.toFixed(decimals))} ${units[index]}`;
}

export function normalizeFiles(input: unknown): NormalizedFile[] {
  if (!Array.isArray(input)) return [];

  return input.flatMap((item, index) => {
    const file =
      item instanceof File
        ? item
        : item && typeof item === 'object' && 'file' in item && item.file instanceof File
          ? (item.file as File)
          : undefined;

    if (!(file instanceof File)) return [];

    const name =
      item && typeof item === 'object' && 'name' in item && typeof item.name === 'string' && item.name
        ? item.name
        : file.name || `file-${index + 1}`;

    const size =
      item && typeof item === 'object' && 'size' in item && typeof item.size === 'number' && !isNaN(item.size)
        ? item.size
        : file.size || 0;

    const type =
      item && typeof item === 'object' && 'type' in item && typeof item.type === 'string'
        ? item.type
        : file.type || 'application/octet-stream';

    const customId =
      item && typeof item === 'object' && 'id' in item && typeof (item as { id?: unknown }).id === 'string' && (item as { id: string }).id
        ? (item as { id: string }).id
        : undefined;

    const id = String(
      customId ??
        `${name}-${size}-${file.lastModified || index}-${Math.random().toString(36).slice(2, 9)}`
    );

    return [
      {
        id,
        name,
        size,
        type,
        file,
      },
    ];
  });
}

/**
 * Safely generates and tracks object URLs for image files.
 * Automatically revokes object URLs when files change or component unmounts to prevent memory leaks and browser exceptions.
 */
export function useSafeThumbnails(files: NormalizedFile[]): Record<string, string> {
  const [thumbnails, setThumbnails] = useState<Record<string, string>>({});
  const activeUrlsRef = useRef<Map<string, string>>(new Map());

  useEffect(() => {
    const nextUrls = new Map<string, string>();
    const newThumbnails: Record<string, string> = {};

    for (const f of files) {
      if (!f.file || !(f.file instanceof File)) continue;
      if (!f.file.type || !f.file.type.startsWith('image/')) continue;

      const cacheKey = `${f.id}-${f.file.name}-${f.file.size}-${f.file.lastModified}`;

      // Check existing active URL
      if (activeUrlsRef.current.has(cacheKey)) {
        const existingUrl = activeUrlsRef.current.get(cacheKey)!;
        nextUrls.set(cacheKey, existingUrl);
        newThumbnails[f.id] = existingUrl;
      } else {
        try {
          const url = URL.createObjectURL(f.file);
          nextUrls.set(cacheKey, url);
          newThumbnails[f.id] = url;
        } catch (err) {
          console.warn('[LocalDrop] Could not create thumbnail for file:', f.name, err);
        }
      }
    }

    // Revoke old URLs that are no longer in nextUrls
    activeUrlsRef.current.forEach((url, key) => {
      if (!nextUrls.has(key)) {
        try {
          URL.revokeObjectURL(url);
        } catch {
          // ignore revoke failure
        }
      }
    });

    activeUrlsRef.current = nextUrls;
    setThumbnails(newThumbnails);

    return () => {
      // Cleanup on unmount
      nextUrls.forEach((url) => {
        try {
          URL.revokeObjectURL(url);
        } catch {
          // ignore revoke failure
        }
      });
    };
  }, [files]);

  return thumbnails;
}
</file>

<file path="client/src/utils/formatFilename.ts">
/**
 * formatFilename.ts
 *
 * Smartly truncates long filenames while preserving the file extension.
 * E.g. "AQN83wlhPbQnTNhmT19jnaJiraGJyAFsSwct3yp2YEIeF_vHt_1T01uM9bxN_2UY-Xbm1Qy2vpNCOo9KdmFULPx.mp4"
 *   -> "AQN83wlhPbQnTNhmT19j…9KdmFULPx.mp4"
 *
 * NOTE: Use strictly for display rendering. Never mutate the actual File or Blob name.
 */
export function formatFilename(filename: string, maxLength = 36): string {
  if (!filename || typeof filename !== 'string') return '';

  const characters = Array.from(filename);
  if (characters.length <= maxLength) {
    return filename;
  }

  const dotIndex = filename.lastIndexOf('.');
  const extension = dotIndex > 0 ? filename.slice(dotIndex) : '';
  const basename = dotIndex > 0 ? filename.slice(0, dotIndex) : filename;
  const base = Array.from(basename);

  const available = maxLength - Array.from(extension).length - 1;

  if (available < 8) {
    return characters.slice(0, maxLength - 1).join('') + '…';
  }

  const startLength = Math.ceil(available * 0.65);
  const endLength = available - startLength;

  return (
    base.slice(0, startLength).join('') +
    '…' +
    base.slice(-endLength).join('') +
    extension
  );
}
</file>

<file path="client/src/utils/iceCandidateQueue.ts">
export class IceCandidateQueue {
  private candidates: RTCIceCandidateInit[] = [];

  async add(pc: RTCPeerConnection, candidate: RTCIceCandidateInit): Promise<void> {
    if (pc.signalingState === 'closed') return;

    if (!pc.remoteDescription) {
      this.candidates.push(candidate);
      return;
    }

    try {
      await pc.addIceCandidate(new RTCIceCandidate(candidate));
    } catch (err) {
      console.warn('[LocalDrop] Immediate ICE candidate error:', err);
    }
  }

  async flush(pc: RTCPeerConnection): Promise<void> {
    if (!pc.remoteDescription) return;
    if (pc.signalingState === 'closed') return;

    while (this.candidates.length > 0) {
      const candidate = this.candidates.shift();
      if (!candidate) continue;

      try {
        await pc.addIceCandidate(new RTCIceCandidate(candidate));
      } catch (error) {
        console.warn('[LocalDrop] Queued ICE candidate rejected:', error);
      }
    }
  }

  clear(): void {
    this.candidates = [];
  }
}
</file>

<file path="client/src/utils/motionPhase.ts">
export type TransferStatus = 'active' | 'complete' | 'failed' | 'cancelled';
export type TransferDirection = 'send' | 'receive';
export type MotionPhase = 'sending' | 'receiving' | 'approval' | 'finalizing' | 'complete' | 'failed' | 'cancelled' | 'paused';
export function clampProgress(value: number): number {
  return Number.isFinite(value) ? Math.max(0, Math.min(100, value)) : 0;
}
export function motionPhase(status: TransferStatus, direction: TransferDirection, progress: number, awaitingApproval = false, paused = false): MotionPhase {
  if (status !== 'active') return status;
  if (awaitingApproval) return 'approval';
  if (paused) return 'paused';
  if (clampProgress(progress) >= 100) return 'finalizing';
  return direction === 'send' ? 'sending' : 'receiving';
}
export function canAnimatePackets(phase: MotionPhase, visible: boolean, reduced: boolean, advancing: boolean): boolean {
  return (phase === 'sending' || phase === 'receiving') && visible && !reduced && advancing;
}
export const phaseLabel: Record<MotionPhase, string> = {
  sending:'Sending', receiving:'Receiving', approval:'Waiting for acceptance', finalizing:'Finalizing', complete:'Complete', failed:'Failed', cancelled:'Cancelled', paused:'Transfer paused',
};
