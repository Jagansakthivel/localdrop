        setTelemetry({
          transferId,
          direction: 'sending',
          fileName: file.name,
          fileMime: mime,
          totalBytes: file.size,
          transferredBytes: offset,
          speedMbps: mbPerSec,
          etaSeconds: eta,
          progress: pct,
          awaitingApproval: false,
