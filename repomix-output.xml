.ld-modal-title {
  font-family: 'Manrope Variable', sans-serif;
  font-size: 24px;
  font-weight: 750;
  margin-bottom: 12px;
}

/* Footer */
.ld-footer {
  padding: 24px;
  text-align: center;
  font-size: 13px;
  color: var(--muted);
}

.ld-footer span {
  margin: 0 6px;
}

/* Responsive adjustments */
@media (max-width: 700px) {
  .ld-pair {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .ld-ticket {
    grid-row: auto;
  }
  .ld-device {
    display: none;
  }
  .ld-main {
    padding-top: 16px;
  }
  .ld-header {
    padding: 16px 20px;
  }
  .ld-intro h1 {
    font-size: 50px;
  }
  .ld-art {
    height: 150px;
  }
  .ld-ticket-body {
    padding: 22px;
  }
  .ld-inputrow .ld-primary {
    flex: none;
  }
}

/* Dark theme component overrides */
.ld-dark .ld-peer {
  background: var(--ld-elevated);
  border-color: var(--line);
  color: var(--ink);
}
.ld-dark .segmented-navigation {
  background: var(--surface);
  border-color: var(--line);
}
.ld-dark .segment-indicator {
  background: var(--ld-secondary);
}
.ld-dark .ld-drop {
  background: var(--surface);
  border-color: var(--line);
}
.ld-dark .ld-plus {
  background: var(--ld-secondary);
  color: var(--ld-animation);
}

/* =========================================
   LOCALDROP — TRANSFER OVERFLOW REPAIR
   ========================================= */

.ld,
.ld-main,
.ld-work,
.ld-activity,
.ld-list,
.ld-row,
.ld-file {
  min-width: 0;
  box-sizing: border-box;
}

/* Transfer containers */

.ld-transfer,
.ld-transfer-card,
.ld-transfer-progress,
.ld-transfer-content,
.ld-transfer-info,
.ld-transfer-details,
.ld-transfer-copy {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* Prevent long filenames expanding the layout */

.ld-transfer-name,
.ld-transfer-filename,
.ld-filename,
.ld-file-name,
.ld-transfer-copy h3,
.ld-transfer h3,
.ld-file strong {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Flexbox sizing */

.ld-transfer-row {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-width: 0;
}

.ld-transfer-row > * {
  min-width: 0;
}

.ld-transfer-info {
  flex: 1 1 0%;
  min-width: 0;
}

/* Progress bar */

.ld-progress,
.ld-progress-track {
  position: relative;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 4px;
  border-radius: 999px;
  background: var(--line);
  overflow: hidden;
}

.ld-progress-fill,
.ld-progress i,
.ld-progress div {
  height: 100%;
  max-width: 100%;
  background: var(--accent);
  border-radius: inherit;
}

/* Transfer metadata */

.ld-transfer-meta,
.ld-metrics {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  width: 100%;
  min-width: 0;
  gap: 4px 12px;
  font-size: 12px;
  color: var(--muted);
}

.ld-transfer-meta > *,
.ld-metrics > * {
  min-width: 0;
  overflow-wrap: anywhere;
}

/* Transfer card structure */
.ld-transfer-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding: 14px 0;
}

.ld-transfer-content {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 10px;
  width: 100%;
  min-width: 0;
}

.ld-transfer-status {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
}

.ld-transfer-filename {
  font-size: 14px;
  font-weight: 550;
  color: var(--ink);
}

@media (max-width: 600px) {
  .ld, .ld-main, .ld-work, .ld-pair, .ld-ticket, .ld-connect {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }
  .ld {
    width: 100%;
  }
  .ld-main {
    width: 100%;
    padding-inline: 16px;
  }
  .ld-work {
    width: 100%;
    grid-template-columns: minmax(0, 1fr);
  }
  .ld-work > *, .ld-peer > *, .ld-actions > * {
    min-width: 0;
  }
  .ld-peer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px;
  }
  .ld-peer > div {
    flex: 1;
    min-width: 0;
  }
  .ld-peer h1, .ld-peer h2, .ld-peer h3 {
    font-size: clamp(17px, 5vw, 24px);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .ld-peer .ld-quiet {
    flex-shrink: 0;
    min-height: 44px;
    font-size: 12px;
  }
  .segmented-navigation {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: 100%;
    min-width: 0;
    gap: 3px;
    padding: 4px;
    box-sizing: border-box;
  }
  .segment {
    position: relative;
    min-width: 0;
    width: 100%;
    min-height: 52px;
    padding: 6px 1px;
  }
  .segment-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    font-size: 10px;
    line-height: 1.2;
    white-space: normal;
  }
  .segment-content svg {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }
  .ld-drop {
    width: 100%;
    min-width: 0;
    min-height: 0;
    padding: 28px 14px;
    box-sizing: border-box;
  }
  .ld-drop h2 {
    font-size: clamp(26px, 7vw, 34px);
  }
  .ld-plus {
    width: 54px;
    height: 54px;
  }
  .ld-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .ld-actions button {
    min-height: 44px;
    max-width: 100%;
  }
  .ld-staged-queue, .ld-staged-card, .ld-list, .ld-row, .ld-file {
    min-width: 0;
    max-width: 100%;
  }
  .ld-file {
    overflow-wrap: anywhere;
  }

  /* Transfer component mobile sizing */
  .ld-transfer {
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }
  .ld-transfer-art {
    max-width: 220px;
    width: 100%;
    margin: 0 auto;
  }
  .ld-transfer-card {
    padding: 12px;
  }
  .ld-transfer-filename {
    font-size: 13px;
    line-height: 1.5;
  }
  .ld-transfer-meta {
    font-size: 11px;
  }
  .ld-transfer-animation {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }
  .ld-row .ld-file {
    flex: 1 1 0%;
    min-width: 0;
  }
  .ld-row .ld-file strong {
    display: block;
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
}

/* =========================================
   LOCALDROP — RECEIVED FILE SAVE ACTION
   ========================================= */

.ld-save-actions {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  width: 100%;
  min-width: 0;
  gap: 10px;
  margin-top: 14px;
}

.ld-save-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 44px;
  max-width: 100%;
  padding: 10px 18px;
  font: inherit;
  font-size: 13px;
  font-weight: 600;
  color: var(--paper);
  background: var(--accent);
  border: 1px solid transparent;
  border-radius: 11px;
  cursor: pointer;
  transition:
    background 180ms ease,
    transform 180ms ease,
    opacity 180ms ease;
}

.ld-save-button:hover:not(:disabled) {
  background: var(--accent-hover);
  transform: translateY(-1px);
}

.ld-save-button:active:not(:disabled) {
  transform: scale(0.97);
}

.ld-save-button:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 4px;
}

.ld-save-button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.ld-save-button svg {
  flex-shrink: 0;
}

/* Selected destination and successful save */
.ld-save-selected,
.ld-save-success,
.ld-save-pending {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  min-width: 0;
  margin-top: 14px;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
  color: var(--ink);
  font-size: 12px;
}

.ld-save-selected > div,
.ld-save-success > div {
  flex: 1;
  min-width: 0;
}

.ld-save-selected svg,
.ld-save-success svg,
.ld-save-pending svg {
  flex-shrink: 0;
}

.ld-save-success svg {
  color: var(--ld-success, #76c7a7);
}

.ld-save-selected svg {
  color: var(--accent);
}

.ld-save-selected strong,
.ld-save-success strong {
  display: block;
  font-size: 13px;
  font-weight: 600;
}

.ld-save-selected span,
.ld-save-success span {
  display: block;
  margin-top: 4px;
  color: var(--muted);
  font-size: 11px;
  overflow-wrap: anywhere;
}

.ld-save-hint {
  flex-basis: 100%;
  min-width: 0;
  font-size: 11px;
  line-height: 1.5;
  color: var(--muted);
}

.ld-save-error {
  display: flex;
  align-items: center;
  gap: 6px;
  max-width: 100%;
  font-size: 12px;
  color: #c94d4d;
  overflow-wrap: anywhere;
}

.ld-dark .ld-save-error {
  color: #ff9b91;
}

/* Dark mode */
.ld-dark .ld-save-selected,
.ld-dark .ld-save-success,
.ld-dark .ld-save-pending {
  background: var(--ld-elevated, #20222d);
  border-color: var(--line, #363846);
  color: var(--ink, #f4f1f1);
}

.ld-dark .ld-save-success svg {
  color: var(--ld-success, #76c7a7);
}

/* Loading animation */
.ld-save-spinner {
  animation: ld-save-spin 800ms linear infinite;
}

@keyframes ld-save-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 600px) {
  .ld-save-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .ld-save-button {
    width: 100%;
    min-height: 44px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ld-save-button {
    transition: none;
  }

  .ld-save-spinner {
    animation: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ld * {
    scroll-behavior: auto !important;
    transition: none !important;
    animation: none !important;
  }
}

/* =========================================
   LOCALDROP — INCOMING TRANSFER POPUP
   ========================================= */

.ld-incoming-dialog {
  position: fixed;
  inset: 0;
  width: min(420px, calc(100% - 32px));
  max-width: 100%;
  max-height: calc(100dvh - 32px);
  min-width: 0;
  margin: auto;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--ink);
  overflow: auto;
  overscroll-behavior: contain;
  z-index: 100;
}

.ld-incoming-dialog::backdrop {
  background: rgb(15 16 22 / 58%);
  backdrop-filter: blur(5px);
}

.ld-incoming-card {
  position: relative;
  width: 100%;
  min-width: 0;
  padding: 28px;
  box-sizing: border-box;
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: 24px;
  box-shadow: 0 24px 80px rgb(0 0 0 / 20%);
  text-align: center;
}

.ld-incoming-handle {
  display: none;
}

/* Request label */
.ld-incoming-kicker {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 650;
  letter-spacing: 0.13em;
}

.ld-incoming-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
}

/* Device illustration */
.ld-incoming-illustration {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin: 26px 0;
}

.ld-incoming-device {
  display: grid;
  place-items: center;
  width: 70px;
  height: 70px;
  flex-shrink: 0;
  color: var(--ink);
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 18px;
}

.ld-incoming-receiver {
  color: var(--accent);
}

.ld-incoming-route {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-width: 0;
}

.ld-incoming-route span {
  width: 10px;
  height: 1px;
  background: var(--line);
}

.ld-incoming-route i {
  width: 5px;
  height: 5px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--accent);
}

/* Typography */
.ld-incoming-card h2 {
  margin: 0;
  font-size: clamp(23px, 6vw, 28px);
  font-weight: 650;
  line-height: 1.15;
  letter-spacing: -0.045em;
}

.ld-incoming-card > p {
  margin: 10px 0 0;
  font-size: 13px;
  line-height: 1.6;
  color: var(--muted);
  overflow-wrap: anywhere;
}

.ld-incoming-card > p strong {
  color: var(--ink);
  font-weight: 600;
}

/* File preview */
.ld-incoming-file {
  display: grid;
  grid-template-columns: 48px minmax(0, 1fr);
  align-items: center;
  gap: 13px;
  width: 100%;
  min-width: 0;
  margin-top: 24px;
  padding: 12px;
  box-sizing: border-box;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 13px;
  text-align: left;
}

.ld-incoming-file-icon {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  color: var(--accent);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 10px;
}

.ld-incoming-file-details {
  min-width: 0;
}

.ld-incoming-file-details strong {
  display: block;
  font-size: 13px;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ld-incoming-file-details span {
  display: block;
  margin-top: 5px;
  font-size: 11px;
  color: var(--muted);
}

.ld-incoming-card .ld-incoming-note {
  margin-top: 14px;
  font-size: 11px;
}

/* Decision buttons */
.ld-incoming-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
  gap: 10px;
  margin-top: 24px;
}

.ld-incoming-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-width: 0;
  min-height: 48px;
  padding: 12px 10px;
  border-radius: 11px;
  font: inherit;
  font-size: 13px;
  font-weight: 650;
  cursor: pointer;
  transition:
    background 180ms ease,
    opacity 180ms ease;
}

.ld-incoming-actions button svg {
  flex-shrink: 0;
}

.ld-incoming-decline {
  color: var(--ink);
  background: transparent;
  border: 1px solid var(--line);
}

.ld-incoming-decline:hover:not(:disabled) {
  background: var(--paper);
}

.ld-incoming-accept {
  color: #211716;
  background: var(--accent);
  border: 1px solid transparent;
}

.ld-incoming-accept:hover:not(:disabled) {
  background: var(--accent-hover);
}

.ld-incoming-actions button:disabled {
  cursor: wait;
  opacity: 0.55;
}

.ld-incoming-actions button:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}

.ld-incoming-card .ld-incoming-error {
  color: #c94d4d;
}

/* =========================================
   DARK MODE
   No legacy olive-green surfaces
   ========================================= */

.ld-dark .ld-incoming-card {
  background: #20222d;
  color: #f4f1f1;
  border-color: #363846;
  box-shadow: 0 24px 80px rgb(0 0 0 / 45%);
}

.ld-dark .ld-incoming-device,
.ld-dark .ld-incoming-file {
  background: #1b1d26;
  border-color: #363846;
}

.ld-dark .ld-incoming-file-icon {
  background: #272a35;
  border-color: #363846;
}

.ld-dark .ld-incoming-receiver {
  color: #b7a4f4;
}

.ld-dark .ld-incoming-route i {
  background: #b7a4f4;
}

.ld-dark .ld-incoming-accept {
  background: #ff8b76;
  color: #211716;
}

.ld-dark .ld-incoming-error {
  color: #ff9b91;
}

/* =========================================
   MOBILE BOTTOM SHEET
   ========================================= */

@media (max-width: 600px) {
  .ld-incoming-dialog {
    inset: auto 0 0;
    width: 100%;
    max-width: 100%;
    max-height: calc(100dvh - 16px);
    margin: 0;
    border-radius: 24px 24px 0 0;
  }

  .ld-incoming-card {
    padding: 14px 20px calc(24px + env(safe-area-inset-bottom));
    border-radius: 24px 24px 0 0;
    border-bottom: 0;
  }

  .ld-incoming-handle {
    display: block;
    width: 32px;
    height: 4px;
    margin: 0 auto 20px;
    border-radius: 10px;
    background: var(--line);
  }

  .ld-incoming-illustration {
    margin: 20px 0;
  }

  .ld-incoming-device {
    width: 62px;
    height: 62px;
  }

  .ld-incoming-actions button {
    min-height: 50px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ld-incoming-actions button {
    transition: none;
  }

  .ld-incoming-dialog::backdrop {
    backdrop-filter: none;
  }
}
