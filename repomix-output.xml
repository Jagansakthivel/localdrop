export type SaveState =
  | "idle"
  | "choosing"
  | "location-selected"
  | "saving"
  | "saved"
  | "download-started"
  | "failed";

export interface ReceivedFileSaveProps {
  filename: string;
  file: File | null;
  receiving: boolean;
  transferFailed?: boolean;
