  outline-offset: 3px;
}

/* Centered creator signature footer */
.ldx-footer {
  margin-top: auto;
  padding: 22px 16px 26px;
  border-top: 1px solid var(--ldx-border);
  color: var(--ldx-secondary);
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.ldx-footer-inner {
  max-width: 1180px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
