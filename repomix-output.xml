}

/* Notice & Status */
.ld-notice {
  color: var(--accent);
  font-size: 14px;
  margin-top: 16px;
  text-align: center;
}

.ld-notice:empty {
  display: none;
}

/* Modal / Dialog */
.ld-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(37, 39, 35, 0.45);
  backdrop-filter: blur(8px);
  z-index: 100;
  display: grid;
  place-items: center;
  padding: 20px;
